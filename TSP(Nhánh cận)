#include <stdio.h>
#define size 30

//Khai bao
typedef struct{
	int dodai;
	int dau, cuoi;
	int dadung;
}canh;

//ten file(de doc file). canh[dau][cuoi], *n: so dinh
void read_file(const char filename[], canh a[][size], int *n){
	int i,j;
	FILE *f;
	f=fopen(filename, "r");
	if(f==NULL){
		printf("Loi mo file!!!\n");
		return;
	}
	//Doc so dinh trong file
	fscanf(f,"%d",n);
	//lay gia tri canh
	for(int i=0; i<=*n; i++){
		for(int j=0;j<=*n;j++){
			a[i][j].dau=i;
			a[i][j].cuoi=j;
			a[i][j].dadung=0;
		}
	}
	fclose(f);
}

//In ma tran
 void in_ma_tran(canh a[][size],int n)
 {
 	int i,j;
 	printf("Ma tran Trong So cua do thi \n");
 	for(i=0;i<=n; i++){
 		for(j=0; j<n;j++){
 			printf(" %c%c= %5.2f ", a[i][j].dau+97, a[i][j].cuoi +97, a[i][j].dodai);
		}
		printf("\n"); 
	 }
 }
 
 //in Phuong an
 
 void in_PA(canh PA[],int n){
 	int i;
 	float sum=0.0;
 	printf("\nPHUONG AN TIM DUOC\n");
 	for(i=0;i<n;i++){
 		sum+=PA[i].dodai;
 		printf(" Canh %c%c = %5.2f\n",PA[i].dau+97, PA[i].cuoi +97, PA[i].dodai);
	}
	printf("CHU TRINH : ");
		for(i=0; i<n; i++){
			printf("%c", PA[i].dau+97);
			printf("->");
		}
		printf("%c",PA[0].dau+97);
		printf("\nTong do dai cac canh cua chu trinh = %5.2f\n",sum);
}


//Tim canh nho nhat trong so cac canh chua them vao chu trinh 
float canh_NN(canh a[][size],int n)
{
	float Cmin=3.40282e+38;
	int i,j;
	for (i=0;i<n;i++){
		for(j=0;j<n;j++){
			if(i!=j && !a[i][j].dadung && a[i][j].dodai<Cmin){
				Cmin=a[i][j].dodai;
				}
			}
		}
	return Cmin;	                                                          
}

//Tim can duoi
float Can_duoi( canh a[][size],float TGT, int n, int i){
	return TGT+(n-i)*canh_NN(a,n);
}

//Ghi nhan PA tot nhat tam thoi

void Cap_nhat_PA_TNTT(canh a[][size],int n, float TGT,float *GTNNTT,canh x[], canh PA[] ){
	int i;
	//mang x co n-1 canh tu n-2->0
	x[n-1]=a[x[n-2].cuoi][x[0].dau];//Noi x[n-2] voi dinh dau x[0]
	TGT=TGT+x[n-1].dodai;
	if(*GTNNTT>TGT) *GTNNTT=TGT;
	for(i=0;i<n;i++){
		PA[i]=x[i];
	}
}

//Ham xac nhan co tao thanh chu trinh khong
int co_chu_trinh(canh x[], int k, int ketiep){
	int i=0, co_chu_trinh=0;
	while(i<k && !co_chu_trinh){
		if(ketiep==x[i].dau) co_chu_trinh=1;
		else i++;
	}
	return co_chu_trinh;
}

void Nhanh_can(canh a[][size], int n, int i, int dau,float *TGT, float *CD,float *GTNNTT, canh x[], canh PA[])
{
	int j;
	for(j=0;j<n;j++){
		if (dau!=j && !a[dau][j].dadung && !co_chu_trinh(x,i,j)){
			*TGT=*TGT+a[dau][j].dodai;
			*CD= Can_duoi(a, *TGT, i, j);
			if(*CD<*GTNNTT)
			{
				x[i]=a[dau][j];
				a[dau][j].dadung=1;
				a[j][dau].dadung=1;
				if (i==n-2)
					Cap_nhat_PA_TNTT(a, n, *TGT, GTNNTT, x,PA);
				else
					Nhanh_can(a,n,i+1,j,TGT,CD,GTNNTT,x,PA);
				
			}
			*TGT=*TGT-a[dau][j].dodai;
			a[dau][j].dadung=0;
			a[j][dau].dadung=0;
		}
	}	
}

void reset(canh a[][size],int n){
	int i,j;
	for (i=0;i<n;i++){
		for(j=0;j<n;j++) a[i][j].dadung=0;
	}
}

int main(){
	canh a[size][size];
	int n;
	printf("\nPhuong an TSP dung thuat toan nhanh can: \n");
	read_file("TSP1.txt",a,&n);
	canh PA[n];
	canh x[n];
	char tpxp, yn;
	while(true){
		fflush(stdin);
		in_ma_tran(a,n);
		float TGT=0,CD=0.0, GTNNTT=3.480282e+38l;
		printf("\nXuat phat tu thanh pho nao ?");
		printf("\nNhap mo thanh pho tu A den %c: ",n-1+97);
		scanf("%c",&tpxp);
		Nhanh_can(a,n,0,tpxp -97, &TGT,&CD,&GTNNTT,x,PA);
		in_PA(PA,n);
		fflush(stdin);
		printf("\nTiep tuc Y/N? ");
		scanf("%c",&yn);
		if(yn=='N'|| yn=='n'){
			break;
		reset(a,n);
		}
	return 0;
	}
}
